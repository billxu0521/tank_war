[gd_scene load_steps=6 format=3]

; 原本內建在 Viewmodel 的手槍，包成 Weapon 場景。
; 根節點的 transform 就是腰射位置（模型朝 +Z、原點在腳下，轉 180 度縮 0.35）。

[ext_resource type="Script" path="res://cowboy/weapon.gd" id="1_weapon"]
[ext_resource type="PackedScene" path="res://assets/models/pistol/scene.gltf" id="2_model"]
[ext_resource type="AudioStream" path="res://assets/audio/weapons/pistol_shoot.mp3" id="3_shoot"]
[ext_resource type="AudioStream" path="res://assets/audio/weapons/pistol_reload.mp3" id="4_reload"]
[ext_resource type="AudioStream" path="res://assets/audio/weapons/no_ammo.mp3" id="5_empty"]

[node name="Pistol" type="Node3D"]
transform = Transform3D(-0.35, 0, 0, 0, 0.35, 0, 0, 0, -0.35, -0.0875, -0.665, -0.175)
script = ExtResource("1_weapon")
display_name = "手槍"
mag_size = 12
damage = 25.0
pellets = 1
fire_interval = 0.22
reload_time = 0.45
ads_position = Vector3(-0.205, -0.61, -0.25)
anim_map = {
"fire": "Pistol_FIRE",
"fire_EMPTY": "Pistol_FIRE_EMPTY",
"idle": "Pistol_IDLE",
"idle_EMPTY": "Pistol_IDLE_EMPTY",
"jump_end": "Pistol_JUMP_END",
"jump_fall": "Pistol_JUMP_FALL",
"jump_fall_EMPTY": "Pistol_JUMP_FALL_EMPTY",
"jump_start": "Pistol_JUMP_START",
"reload_round": "Pistol_RELOAD",
"run": "Pistol_RUN",
"run_EMPTY": "Pistol_RUN_EMPTY",
"walk": "Pistol_WALK",
"walk_EMPTY": "Pistol_WALK_EMPTY"
}

[node name="Model" parent="." instance=ExtResource("2_model")]

[node name="ShootSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_shoot")

[node name="ReloadSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_reload")

[node name="EmptySound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_empty")
