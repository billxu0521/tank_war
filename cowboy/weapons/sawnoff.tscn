[node name="Sawnoff" type="Node3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.16, -0.22, -0.2)
script = ExtResource("1_weapon")
display_name = "雙管"
mag_size = 2
damage = 10.0
pellets = 8
pellet_spread = 5.0
fire_interval = 0.3
reload_whole_mag = true
reload_time = 2.2
recoil_scale = 2.2
ads_position = Vector3(0.0, -0.18, -0.2)

; 槍身空間 +Z 朝前，轉 180 度讓槍口對出去；0.01 = 公分轉公尺
[node name="Model" type="Node3D" parent="."]
