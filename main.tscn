[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://main.gd" id="1"]
[ext_resource type="Script" path="res://egg.gd" id="2"]

[sub_resource type="ProceduralSkyMaterial" id="sky_m"]
sky_top_color = Color(0.33, 0.45, 0.62, 1)
sky_horizon_color = Color(0.86, 0.70, 0.52, 1)
ground_horizon_color = Color(0.62, 0.55, 0.44, 1)
sun_angle_max = 20.0

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_m")

[sub_resource type="Environment" id="env"]
background_mode = 2
sky = SubResource("sky")
ambient_light_source = 3
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.74, 0.68, 0.56, 1)
fog_density = 0.005
fog_sky_affect = 0.3

[sub_resource type="StyleBoxFlat" id="bar_bg"]
bg_color = Color(0, 0, 0, 0.45)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="bar_fill"]
bg_color = Color(0.95, 0.75, 0.15, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="SceneReplicationConfig" id="egg_repl"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:carrier")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:extract")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:pickup")
properties/3/spawn = true
properties/3/replication_mode = 1

[node name="Main" type="Node3D" groups=["match"]]
script = ExtResource("1")

[node name="Arena" type="Node3D" parent="." groups=["arena"]]

[node name="WorldEnvironment" type="WorldEnvironment" parent="Arena"]
environment = SubResource("env")

; 黃昏的斜陽：仰角約 25 度、偏暖。影子拉長，比較有 Hunt 那種傍晚的氣氛
[node name="Sun" type="DirectionalLight3D" parent="Arena"]
transform = Transform3D(0.866, -0.2113, 0.4532, 0, 0.9063, 0.4226, -0.5, -0.366, 0.785, 0, 20, 0)
light_color = Color(1, 0.84, 0.64, 1)
light_energy = 1.3
shadow_enabled = true

[node name="Egg" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3, 0)
script = ExtResource("2")

; 網格在 main.gd 的 _skin_egg() 從 props.glb 換上來
[node name="MeshInstance3D" type="MeshInstance3D" parent="Egg"]

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="Egg"]
replication_config = SubResource("egg_repl")

[node name="Players" type="Node3D" parent="."]

[node name="MultiplayerSpawner" type="MultiplayerSpawner" parent="."]
_spawnable_scenes = PackedStringArray("res://cowboy/cowboy.tscn", "res://dino.tscn")
spawn_path = NodePath("../Players")

; 大廳、選單、狀態列：蓋在牛仔的 HUD（準心、體力條）上面，不然選單打開時準心壓在按鈕上
[node name="UI" type="CanvasLayer" parent="."]
layer = 5

[node name="Root" type="Control" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Lobby" type="VBoxContainer" parent="UI/Root"]
offset_left = 24.0
offset_top = 24.0
offset_right = 340.0
offset_bottom = 320.0
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="UI/Root/Lobby"]
text = "西部牛仔打恐龍"

[node name="Hint" type="Label" parent="UI/Root/Lobby"]
text = "兩個模式：連線模式（大家都是牛仔，開房的人把 IP 給朋友）、沙盒模式（一個人練槍）。
WASD 移動，滑鼠瞄準，左鍵開槍，右鍵舉槍，Esc 開選單（主機可以在選單加移動標靶、牛仔 bot）。
1 左輪 2 單管散彈 3 槓桿步槍。舉槍時 Shift 閉氣，R 換彈，V 槍托（按住蓄力＝重擊），F 開門／爬梯子，
Shift 跑，C 切換蹲／Ctrl 按住蹲，靠近矮牆按住往前＋Space 翻越。左輪腰射按住左鍵＝搧擊錘。打頭一槍死。
連線模式一局四分鐘，先把蛋帶進藍色撤離區的人贏；死了五秒後重生。"

[node name="IP" type="LineEdit" parent="UI/Root/Lobby"]
text = "127.0.0.1"
placeholder_text = "主機 IP"

[node name="HostBtn" type="Button" parent="UI/Root/Lobby"]
text = "開房（連線模式）"

[node name="JoinBtn" type="Button" parent="UI/Root/Lobby"]
text = "加入（連線模式）"

[node name="SandboxBtn" type="Button" parent="UI/Root/Lobby"]
text = "沙盒模式（牛仔練習場，打靶、練翻越）"

[node name="ViewerBtn" type="Button" parent="UI/Root/Lobby"]
text = "檢視模型（看牛仔、槍和恐龍長怎樣）"

[node name="Menu" type="Control" parent="UI/Root"]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Dim" type="ColorRect" parent="UI/Root/Menu"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.55)

[node name="Box" type="VBoxContainer" parent="UI/Root/Menu"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -170.0
offset_right = 140.0
offset_bottom = 170.0
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="UI/Root/Menu/Box"]
text = "暫停"
horizontal_alignment = 1

[node name="ResumeBtn" type="Button" parent="UI/Root/Menu/Box"]
text = "繼續遊戲"

[node name="LeaveBtn" type="Button" parent="UI/Root/Menu/Box"]
text = "回到大廳"

[node name="QuitBtn" type="Button" parent="UI/Root/Menu/Box"]
text = "離開遊戲"

; 遊戲局控制：只有主機看得到（bot 都在主機上跑），main.gd 的 _set_menu 決定顯示
